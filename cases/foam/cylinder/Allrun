#!/usr/bin/env bash
# NP = number of MPI ranks (default: all cores up to 4)
cd "${0%/*}" || exit
NP=${NP:-$(nproc)}; [ "$NP" -gt 4 ] && NP=4
rm -rf 0 && cp -r 0.orig 0
blockMesh > log.blockMesh 2>&1 || { tail -20 log.blockMesh; exit 1; }
checkMesh > log.checkMesh 2>&1
setFields > log.setFields 2>&1
if [ "$NP" -gt 1 ]; then
  sed -i "s/^numberOfSubdomains .*/numberOfSubdomains $NP;/" system/decomposeParDict
  decomposePar -force > log.decomposePar 2>&1
  mpirun --allow-run-as-root --oversubscribe -np "$NP" icoFoam -parallel > log.icoFoam 2>&1
  reconstructPar -latestTime > log.reconstructPar 2>&1
else
  icoFoam > log.icoFoam 2>&1
fi
